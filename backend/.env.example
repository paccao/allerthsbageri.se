NODE_ENV=development
PORT=4000 # Default is 3000 in the code
DATABASE_URL=dev.db

# Should never be used for logging in but we use it to connect the BFF API key to a specific user, a service account user
BFF_ADMIN_USERNAME=replace-with-generated-username
BFF_ADMIN_PASSWORD=replace-with-generated-password
# Should match with frontend/.env. Max 64 chars.
BFF_API_KEY=
