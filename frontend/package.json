{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "encrypt:email": "node --env-file .env scripts/encrypt-email.ts"
  },
  "dependencies": {
    "@fontsource/italianno": "^5.3.0",
    "@fontsource/quattrocento": "^5.3.0",
    "@keystatic/core": "^0.5.51",
    "intl-tel-input": "^26.9.2",
    "keystatic-sveltekit": "^1.3.1",
    "openapi-fetch": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "runed": "^0.37.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit-svelte/svelte": "^0.1.6",
    "@dnd-kit/abstract": "^0.2.4",
    "@dnd-kit/helpers": "^0.2.4",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/enhanced-img": "^0.10.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^25.9.9",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "layerchart": "2.0.0-next.43",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^7.3.7"
  },
  "prettier": {
    "tabWidth": 2,
    "singleQuote": true,
    "semi": false,
    "plugins": [
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ],
    "tailwindStylesheet": "./src/app.css"
  }
}
